    "def augment_features(X):\n",
    "    # pastikan input dalam bentuk numpy\n",
    "    X = np.array(X, dtype=float)\n",
    "\n",
    "    log_feat = np.log1p(np.clip(X, a_min=0, a_max=None))\n",
    "    sqrt_feat = np.sqrt(np.clip(X, a_min=0, a_max=None))\n",
    "    inv_feat = 1 / (np.abs(X) + 1e-6)\n",
    "\n",
    "    # gabungkan fitur asli + transformasi\n",
    "    return np.hstack([X, log_feat, sqrt_feat, inv_feat])\n",
    "\n",
    "def log_transform(X):\n",
    "    X = np.array(X, dtype=float)\n",
    "    return np.log1p(np.clip(X, a_min=0, a_max=None))"
   ]
  },
